{
  "name": "@chowgo/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral business logic shared by the web and mobile clients.",
  "exports": {
    "./constants": "./src/constants.js",
    "./currency": "./src/currency.js",
    "./dates": "./src/dates.js",
    "./format": "./src/format.js",
    "./geo": "./src/geo.js",
    "./i18n": "./src/i18n/index.js",
    "./legal": "./src/legal/index.js",
    "./image": "./src/image.js",
    "./i18n/config": "./src/i18n/config.js",
    "./i18n/fieldErrors": "./src/i18n/fieldErrors.js",
    "./menuItemSchema": "./src/menuItemSchema.js",
    "./menuOptions": "./src/menuOptions.js",
    "./money": "./src/money.js",
    "./promoCode": "./src/promoCode.js",
    "./promotion": "./src/promotion.js",
    "./schedule": "./src/schedule.js",
    "./searchFilters": "./src/searchFilters.js",
    "./strings": "./src/strings.js",
    "./validation": "./src/validation.js",
    "./adapters/menu": "./src/adapters/menu.js",
    "./adapters/order": "./src/adapters/order.js",
    "./adapters/pricing": "./src/adapters/pricing.js",
    "./adapters/restaurant": "./src/adapters/restaurant.js",
    "./adapters/types": "./src/adapters/types.js"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "zod": "^4.1.11"
  },
  "scripts": {
    "check:locales": "node scripts/check-locales.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:keys": "node scripts/check-keys.mjs",
    "check": "npm run check:locales && npm run check:imports && npm run check:keys && npm run check:legal",
    "check:legal": "node scripts/check-legal.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
