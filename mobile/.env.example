# Leave unset for a simulator or an Expo dev client on the same LAN — src/lib/config.js
# derives the host from Expo's packager. Set these for a tunnel, staging or production.
# EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok.app/api
# EXPO_PUBLIC_SOCKET_URL=https://your-tunnel.ngrok.app

# Maps need no key: MapLibre renders OpenFreeMap tiles, which are free and
# require no account. Nothing to configure here.

# Google sign-in on a physical device needs the backend reachable over HTTPS:
# Google rejects private-network redirect URIs, so a LAN IP will not work.
# Register the tunnel URL as a second authorized redirect URI in Google Cloud
# Console and point EXPO_PUBLIC_API_URL at it.

# Crash reporting. Monitoring stays off without a DSN. For readable stack
# traces, set SENTRY_AUTH_TOKEN (secret), SENTRY_ORG and SENTRY_PROJECT as EAS
# environment variables: builds upload source maps when all three are present
# and carry on without them (SENTRY_ALLOW_FAILURE). After `eas update`, upload
# the OTA bundle's maps too: npx sentry-expo-upload-sourcemaps dist
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
