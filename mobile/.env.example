# Leave unset for a simulator or an Expo dev client on the same LAN — src/lib/config.js
# derives the host from Expo's packager. Set these for a tunnel, staging or production.
# EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok.app/api
# EXPO_PUBLIC_SOCKET_URL=https://your-tunnel.ngrok.app

# Android only - Apple Maps needs no key. Create one in Google Cloud Console
# with the "Maps SDK for Android" enabled, restricted to the app's package name
# and signing certificate. Without it the Android map renders blank.
# EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
